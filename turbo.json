{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "NODE_ENV",
        "LHCI",
        "ANALYZE",
        "VERCEL",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint:eslint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "dependsOn": ["^lint"]
    },
    "lint:prettier": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "dependsOn": ["^lint"]
    },
    "lint:text": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "dependsOn": ["^lint"]
    },
    "fix": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "fix:eslint": {
      "cache": false
    },
    "fix:prettier": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "analyze": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test": {
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "typecheck": {
      "cache": false
    },
    "lint:architecture": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/check-architecture*.mjs"]
    }
  },
  "globalEnv": ["NODE_ENV", "CI"],
  "globalDependencies": [
    ".env*",
    "tsconfig.json",
    "package.json",
    "packages/*-config/**",
    "scripts/**",
    "prettier.config.mjs",
    ".gitignore"
  ],
  "globalPassThroughEnv": ["NODE_ENV", "CI", "VERCEL", "VERCEL_ENV", "SENTRY_AUTH_TOKEN"]
}
