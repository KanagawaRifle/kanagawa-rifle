{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "NODE_ENV",
        "NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY",
        "NEXT_PUBLIC_GOOGLE_CALENDAR_ID",
        "GOOGLE_CALENDAR_API_KEY",
        "GOOGLE_CALENDAR_ID",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env.local", ".env.production"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", ".eslintrc*", "tsconfig.json"]
    },
    "lint:eslint": {
      "outputs": [],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", ".eslintrc*"]
    },
    "lint:prettier": {
      "outputs": [],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json", "**/*.md", ".prettierrc*"]
    },
    "lint:text": {
      "outputs": [],
      "inputs": ["**/*.md", "**/*.txt", ".textlintrc*"]
    },
    "fix": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "fix:eslint": {
      "cache": false
    },
    "fix:prettier": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "analyze": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test": {
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "typecheck": {
      "cache": false
    }
  },
  "globalEnv": ["NODE_ENV", "CI"],
  "globalDependencies": [".env", ".env.local", "tsconfig.json", "package.json"],
  "globalPassThroughEnv": ["NODE_ENV", "CI", "VERCEL", "VERCEL_ENV", "SENTRY_AUTH_TOKEN"]
}
