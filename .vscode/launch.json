{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: server and browser",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run -w @acme/website dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/packages/website"
      }
    },
    {
      "name": "Node.js: attach",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
