{
  "name": "acme",
  "version": "1.0.0",
  "private": true,
  "description": "神奈川県ライフル射撃協会",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "packages/website",
    "packages/eslint-config",
    "packages/lighthouse-config",
    "packages/prettier-config",
    "packages/stylelint-config",
    "packages/typescript-config",
    "packages/minimatch-compat"
  ],
  "devDependencies": {
    "@acme/stylelint-config": "*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@eslint/js": "^9",
    "cspell": "^10.0.1",
    "eslint": "^9",
    "generate-license-file": "4.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "js-yaml": "^4.3.2",
    "knip": "^6.26.0",
    "licensee": "^12.0.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "minimatch": "file:packages/minimatch-compat",
    "picomatch": "4.0.7",
    "prettier": "^3.7.4",
    "snyk": "^1.1301.2",
    "stylelint": "^17",
    "syncpack": "^14.2.1",
    "textlint": "^15.8.0",
    "textlint-rule-ja-space-between-half-and-full-width": "^2.4.2",
    "turbo": "^2.10.11",
    "typescript": "^5"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "overrides": {
    "minimatch@<9": "$minimatch",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    },
    "rehype-katex": {
      "katex": "^0.18.2"
    },
    "micromark-extension-math": {
      "katex": "^0.18.2"
    },
    "generate-license-file": {
      "zod": "^4.6.7"
    },
    "glob@>=9 <14.0.2": "14.0.3",
    "minimatch@>=9 <11.0.1": "11.0.4"
  },
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "lint-staged": "lint-staged",
    "lint": "npm run lint:tracked && npm run lint:eslint:tooling && npm run lint:prettier && npm run lint:text && turbo run lint",
    "lint:eslint": "turbo run lint:eslint",
    "lint:prettier": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check .",
    "fix": "turbo run fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "security": "snyk test --all-projects --severity-threshold=high",
    "security:fix": "snyk fix --all-projects",
    "lint:architecture": "npm run -w @acme/website lint:architecture",
    "lint:tracked": "node scripts/check-tracked-files.mjs",
    "dev": "turbo run dev --env-mode=loose",
    "doctor": "node scripts/doctor.mjs",
    "check": "npm run typecheck && npm run contracts:check && npm run lint && npm run syncpack && npm run knip && npm run cspell && npm run license-check && npm run test:tooling",
    "qa": "npm run check && npm run build && npm run size-limit && npm run test:coverage && npm run -w @acme/website test:storybook && npm audit --audit-level=high",
    "lint:eslint:tooling": "eslint scripts .husky/install.mjs *.config.mjs stylelint.config.js packages/eslint-config packages/prettier-config packages/stylelint-config packages/lighthouse-config packages/minimatch-compat --max-warnings 0",
    "lint:infra": "node scripts/lint-infra.mjs",
    "test:tooling": "node --test scripts/*.test.mjs packages/eslint-config/tests/*.test.mjs packages/minimatch-compat/test/*.test.cjs && npm run -w @acme/website test:tooling",
    "test:coverage": "turbo run test:coverage",
    "coverage:diff": "node scripts/coverage-diff-check.mjs",
    "syncpack": "syncpack lint",
    "knip": "knip",
    "cspell": "cspell --no-progress",
    "license-check": "licensee --errors-only",
    "sbom": "npm sbom --sbom-format=cyclonedx --omit=dev",
    "lint:text": "node scripts/lint-text.mjs",
    "fix:text": "node scripts/lint-text.mjs --fix",
    "lint:styles": "turbo run lint:styles",
    "license-report": "node scripts/generate-third-party-licenses.mjs",
    "size-limit": "turbo run size-limit",
    "contracts:check": "npm run api:check --workspaces --if-present && npm run env:check --workspaces --if-present",
    "graph": "npm run -w @acme/website graph",
    "lint:markdown": "npm run -w @acme/website lint:markdown",
    "lint:links": "npm run -w @acme/website lint:links"
  }
}
