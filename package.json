{
  "name": "kanagawa-rifle",
  "version": "1.0.0",
  "private": true,
  "description": "神奈川県ライフル射撃協会",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/website",
    "packages/eslint-config",
    "packages/lighthouse-config",
    "packages/prettier-config",
    "packages/stylelint-config",
    "packages/typescript-config"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "cspell": "^9.4.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "knip": "^5.77.1",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.7.1",
    "typescript": "^5"
  },
  "volta": {
    "node": "22.15.0"
  },
  "scripts": {
    "prepare": "node -e \"if (process.env.CI || process.env.VERCEL) process.exit(0)\" || husky",
    "lint-staged": "lint-staged",
    "lint": "turbo run lint",
    "lint:eslint": "turbo run lint:eslint",
    "lint:prettier": "turbo run lint:prettier",
    "fix": "turbo run fix",
    "test": "turbo run test",
    "build": "turbo run build",
    "security": "snyk test --all-projects --severity-threshold=high",
    "security:fix": "snyk fix --all-projects"
  }
}
