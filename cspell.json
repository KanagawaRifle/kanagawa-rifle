{
  "version": "0.2",
  "import": ["./packages/website/.cspell.json"],
  "useGitignore": true,
  "files": [
    "*.{md,mjs,js,json}",
    "scripts/**/*.mjs",
    ".github/**/*.{yml,md,json}",
    "packages/**/*.{md,ts,tsx,js,mjs,cjs,json,css}"
  ],
  "ignorePaths": ["package-lock.json", "licenses/**"],
  "words": [
    "actionlint",
    "AMRT",
    "autobuild",
    "commitlint",
    "cyclonedx",
    "depcruise",
    "dessant",
    "Dockerfiles",
    "dorny",
    "elif",
    "gitleaks",
    "gpgsign",
    "hadolint",
    "hoso",
    "instanton",
    "instrumentable",
    "KanagawaRifle",
    "kinshi",
    "koalaman",
    "LICENCE",
    "lychee",
    "lycheeverse",
    "mailpit",
    "networkidle",
    "nosemgrep",
    "nvmrc",
    "ossf",
    "pipefail",
    "prerendered",
    "Redocly",
    "rhysd",
    "ruleset",
    "rulesets",
    "SARIF",
    "semgrep",
    "shellcheck",
    "syncpackrc",
    "textconv",
    "textlint",
    "textlintignore",
    "unasserted",
    "unawaited",
    "Vitest",
    "yogo",
    "zizmor",
    "zizmorcore"
  ],
  "ignoreRegExpList": ["\\b[0-9a-fA-F]{6}\\b"]
}
