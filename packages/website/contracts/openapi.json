{
  "openapi": "3.1.0",
  "info": {
    "title": "Kanagawa Rifle website API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://kanagawa-rifle.org"
    }
  ],
  "paths": {
    "/api/news": {
      "get": {
        "operationId": "listNews",
        "summary": "ニュース一覧",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 12,
              "maximum": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "一覧。各記事の content は空文字。範囲外のページは空の配列。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["data", "pagination"],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/NewsItem"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "不正なページ指定",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "記事の読込・形式エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/news/{slug}": {
      "get": {
        "operationId": "getNews",
        "summary": "ニュース本文",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "記事本文を含む詳細",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/NewsItem"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "不正な slug",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "記事なし",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "記事の読込・形式エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/og": {
      "get": {
        "operationId": "getOpenGraphImage",
        "summary": "OGP 画像",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "省略・不正な値の場合はサイト名を使用。"
          }
        ],
        "responses": {
          "200": {
            "description": "PNG 画像",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "500": {
            "description": "画像生成に失敗"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewsItem": {
        "type": "object",
        "required": ["slug", "title", "published", "tags", "content"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string"
          },
          "published": {
            "type": "string",
            "format": "date-time"
          },
          "updated": {
            "type": "string",
            "format": "date-time"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excerpt": {
            "type": "string"
          },
          "eyecatch": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": ["current", "size", "total", "totalPages", "hasNext", "hasPrev"],
        "properties": {
          "current": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "hasNext": {
            "type": "boolean"
          },
          "hasPrev": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["data", "error"],
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "required": ["code", "message", "status"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
