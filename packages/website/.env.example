########################################################################
#
# 基本設定
#
########################################################################

NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=https://static.kanagawa-rifle.org
# 添付ファイルのルートを個別指定する場合。未設定時は CDN_URL + /website
# NEXT_PUBLIC_STATIC_FILE_BASE_URL=https://static.kanagawa-rifle.org/website

########################################################################
#
# サードパーティー
#
########################################################################

# Axiom
NEXT_PUBLIC_AXIOM_DATASET=
NEXT_PUBLIC_AXIOM_TOKEN=

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Sentry
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=

# Clarity
NEXT_PUBLIC_CLARITY_ID=

# ステージング認証（VERCEL_GIT_COMMIT_REF=staging の場合）
BASIC_AUTH_ID=
BASIC_AUTH_PASSWORD=

# ローカル検証・バンドル分析
# LHCI=1
# ANALYZE=true
