{
  "name": "@acme/website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "run-p -l -c --aggregate-output lint:*",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:prettier": "prettier --ignore-path ../../.gitignore --log-level error --check .",
    "lint:text": "textlint '**/*.{md,txt}'",
    "fix": "run-s --continue-on-error fix:*",
    "fix:eslint": "eslint . --max-warnings 0 --fix",
    "fix:prettier": "prettier --ignore-path ../../.gitignore --log-level error --write .",
    "spell": "cspell lint --no-progress '**/*.{ts,tsx,js,jsx,json,md,html,css,scss,txt}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "npm run build && playwright test e2e/accessibility.spec.ts",
    "lhci": "rm -rf .next && npm run build && lhci autorun --config=.lighthouserc.cjs",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test-storybook:a11y": "test-storybook --url http://localhost:6006",
    "test:content": "vitest run src/features/news/server/__tests__/content.test.ts",
    "lint:architecture": "node ../../scripts/check-architecture.mjs && node --test ../../scripts/check-architecture.test.mjs"
  },
  "dependencies": {
    "@next/third-parties": "16.3.6",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.32.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-string": "^3.0.1",
    "html-url-attributes": "^3.0.1",
    "js-yaml": "3.15.2",
    "katex": "^0.16.23",
    "lucide-react": "^0.562.0",
    "next": "16.3.6",
    "next-axiom": "^1.9.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@acme/eslint-config": "*",
    "@acme/lighthouse-config": "*",
    "@acme/prettier-config": "*",
    "@acme/typescript-config": "*",
    "@axe-core/playwright": "^4.11.0",
    "@lhci/cli": "^0.14.0",
    "@next/bundle-analyzer": "16.3.6",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-themes": "^10.1.11",
    "@storybook/nextjs": "^10.1.11",
    "@storybook/test-runner": "^0.24.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@textlint-ja/textlint-rule-no-insert-dropping-sa": "^2.0.1",
    "@textlint-ja/textlint-rule-no-synonyms": "^1.3.0",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "3.2.6",
    "@vitest/ui": "3.2.6",
    "axe-playwright": "^2.2.2",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-storybook": "^10.1.11",
    "jsdom": "^27.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.23",
    "snyk": "^1.1301.2",
    "storybook": "^10.2.10",
    "sudachi-synonyms-dictionary": "^15.0.0",
    "tailwindcss": "^4",
    "textlint": "^15.5.0",
    "textlint-rule-ja-hiragana-fukushi": "^1.3.0",
    "textlint-rule-ja-hiragana-hojodoushi": "^1.1.0",
    "textlint-rule-ja-no-inappropriate-words": "^2.0.0",
    "textlint-rule-ja-no-orthographic-variants": "^2.0.0",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-ja-unnatural-alphabet": "^2.0.1",
    "textlint-rule-jis-charset": "^0.1.1",
    "textlint-rule-no-doubled-joshi": "^5.1.0",
    "textlint-rule-no-hoso-kinshi-yogo": "^1.3.2",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
    "textlint-rule-no-start-duplicated-conjunction": "^2.0.2",
    "textlint-rule-no-surrogate-pair": "^1.0.1",
    "textlint-rule-prefer-tari-tari": "^1.0.3",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "textlint-rule-use-si-units": "^2.0.0",
    "vitest": "3.2.6"
  }
}
