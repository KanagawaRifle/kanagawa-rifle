{
  "name": "@kanagawa-rifle/website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "run-p -l -c --aggregate-output lint:*",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:prettier": "prettier --ignore-path ../../.gitignore --log-level error --check .",
    "lint:text": "textlint '**/*.{md,txt}'",
    "fix": "run-s --continue-on-error fix:*",
    "fix:eslint": "eslint . --max-warnings 0 --fix",
    "fix:prettier": "prettier --ignore-path ../../.gitignore --log-level error --write .",
    "spell": "cspell lint --no-progress '**/*.{ts,tsx,js,jsx,json,md,html,css,scss,txt}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:vrt": "playwright test e2e/visual.spec.ts",
    "test:vrt:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "lhci": "npm run build && lhci autorun --config=.lighthouserc.cjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/google-calendar": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@kanagawa-rifle/eslint-config": "*",
    "@kanagawa-rifle/lighthouse-config": "*",
    "@kanagawa-rifle/prettier-config": "*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/material-nextjs": "^7.3.6",
    "@next/bundle-analyzer": "^15.5.4",
    "@next/third-parties": "^15.5.2",
    "@sentry/nextjs": "^10.32.1",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next": "15.5.9",
    "next-axiom": "^1.9.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.0.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.0.1",
    "remark-math": "^6.0.0",
    "strip-markdown": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@axe-core/react": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@textlint-ja/textlint-rule-no-insert-dropping-sa": "^2.0.1",
    "@textlint-ja/textlint-rule-no-synonyms": "^1.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "axe-core": "^4.11.0",
    "dotenv": "^17.2.2",
    "eslint-config-next": "15.5.6",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.3.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.97.1",
    "snyk": "^1.1301.2",
    "sudachi-synonyms-dictionary": "^15.0.0",
    "tailwindcss": "^4",
    "textlint": "^15.5.0",
    "textlint-rule-ja-hiragana-fukushi": "^1.3.0",
    "textlint-rule-ja-hiragana-hojodoushi": "^1.1.0",
    "textlint-rule-ja-no-inappropriate-words": "^2.0.0",
    "textlint-rule-ja-no-orthographic-variants": "^2.0.0",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-ja-unnatural-alphabet": "^2.0.1",
    "textlint-rule-jis-charset": "^0.1.1",
    "textlint-rule-no-doubled-joshi": "^5.1.0",
    "textlint-rule-no-hoso-kinshi-yogo": "^1.3.2",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
    "textlint-rule-no-start-duplicated-conjunction": "^2.0.2",
    "textlint-rule-no-surrogate-pair": "^1.0.1",
    "textlint-rule-prefer-tari-tari": "^1.0.3",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "textlint-rule-use-si-units": "^2.0.0",
    "vitest": "^3.2.4"
  }
}
