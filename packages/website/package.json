{
  "name": "@acme/website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "typecheck": "next typegen && node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "start": "next start",
    "lint": "run-s lint:eslint lint:prettier lint:styles lint:architecture lint:markdown depcruise",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:prettier": "prettier --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --log-level error --check .",
    "lint:text": "textlint --config .textlintrc.json --ignore-path .textlintignore \"src/contents/**/*.md\"",
    "fix": "run-s --continue-on-error fix:*",
    "fix:eslint": "eslint . --max-warnings 0 --fix",
    "fix:prettier": "prettier --ignore-path ../../.gitignore --log-level error --write .",
    "spell": "cspell lint --no-progress '**/*.{ts,tsx,js,jsx,json,md,html,css,scss,txt}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:e2e:staging": "cross-env VERCEL_GIT_COMMIT_REF=staging npm run build && playwright test --config playwright.staging.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "npm run build && playwright test e2e/accessibility.spec.ts",
    "lhci": "cross-env LHCI=1 npm run build && npm run lhci:run",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --config vitest.storybook.config.ts",
    "test-storybook:a11y": "npm run test-storybook",
    "test:content": "vitest run src/features/news/server/__tests__/content.test.ts",
    "lint:architecture": "node ../../scripts/check-architecture.mjs && node --test ../../scripts/check-architecture.test.mjs",
    "test:coverage": "vitest run --coverage",
    "lint:styles": "stylelint \"src/**/*.css\" --max-warnings 0",
    "fix:styles": "stylelint \"src/**/*.css\" --fix",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "size-limit": "size-limit",
    "test:mutation": "stryker run",
    "new:news": "tsx scripts/new-news.ts",
    "test:tooling": "node --test scripts/*.test.mjs",
    "api:check": "npm run api:lint && node scripts/check-api-routes.mjs",
    "api:lint": "redocly lint --config redocly.lint.yaml contracts/openapi.json",
    "env:check": "node scripts/check-env.mjs",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "graph": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid",
    "lint:markdown": "tsx scripts/lint-markdown.ts",
    "lint:links": "node scripts/check-links.mjs",
    "lint:links:external": "node scripts/check-links.mjs --external",
    "lint:links:prepare": "node scripts/check-links.mjs --prepare",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "benchmark:browser": "node scripts/measure-performance.mjs",
    "test:storybook": "npm run build-storybook && npm run test-storybook",
    "test:load:smoke": "cross-env LHCI=1 npm run build && npm run test:load:smoke:run",
    "test:load:smoke:run": "cross-env LHCI=1 node scripts/k6.mjs smoke",
    "test:load": "node scripts/k6.mjs load",
    "test:install": "playwright install --with-deps chromium webkit",
    "test:deployment:local": "cross-env LHCI=1 node scripts/local-smoke.mjs",
    "lhci:run": "cross-env LHCI=1 node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@next/third-parties": "16.4.5",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "hast-util-to-string": "^3.0.1",
    "html-url-attributes": "^3.0.1",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-axiom": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@acme/eslint-config": "*",
    "@acme/lighthouse-config": "*",
    "@acme/prettier-config": "*",
    "@acme/stylelint-config": "*",
    "@acme/typescript-config": "*",
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "16.4.5",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "2.75.0",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@textlint-ja/textlint-rule-no-insert-dropping-sa": "^2.0.1",
    "@textlint-ja/textlint-rule-no-synonyms": "^1.3.0",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-storybook": "10.6.5",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-lint": "^10.0.1",
    "remark-lint-no-duplicate-definitions": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "size-limit": "^14.3.0",
    "storybook": "10.6.5",
    "stylelint": "^17.16.0",
    "sudachi-synonyms-dictionary": "^20.0.0",
    "tailwindcss": "^4.3.4",
    "textlint": "^15.8.0",
    "textlint-rule-ja-hiragana-fukushi": "^1.3.0",
    "textlint-rule-ja-hiragana-hojodoushi": "^1.1.0",
    "textlint-rule-ja-no-inappropriate-words": "^2.0.0",
    "textlint-rule-ja-no-orthographic-variants": "^2.0.0",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-ja-unnatural-alphabet": "^2.0.1",
    "textlint-rule-jis-charset": "^0.1.2",
    "textlint-rule-no-doubled-joshi": "^5.1.1",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
    "textlint-rule-no-start-duplicated-conjunction": "^2.0.2",
    "textlint-rule-no-surrogate-pair": "^1.0.1",
    "textlint-rule-prefer-tari-tari": "^1.0.3",
    "textlint-rule-preset-ja-spacing": "^3.0.4",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "textlint-rule-use-si-units": "^2.0.0",
    "tsx": "^4.23.15",
    "vfile": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0",
    "webpack": "^5.112.2"
  }
}
