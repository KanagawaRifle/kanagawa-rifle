# Serve static assets with an efficient cache policy
# see: https://developer.chrome.com/docs/lighthouse/performance/uses-long-cache-ttl/
<IfModule mod_expires.c>
  ExpiresActive on
  ExpiresDefault                                    "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon            "access plus 1 week"
  ExpiresByType image/x-icon                        "access plus 1 week"
  ExpiresByType application/manifest+json           "access plus 1 week"
  ExpiresByType application/x-web-app-manifest+json "access"
  ExpiresByType text/cache-manifest                 "access"
  ExpiresByType application/atom+xml                "access plus 1 hour"
  ExpiresByType application/rdf+xml                 "access plus 1 hour"
  ExpiresByType application/rss+xml                 "access plus 1 hour"
  ExpiresByType text/html                           "access"
  ExpiresByType text/markdown                       "access"
  ExpiresByType text/calendar                       "access"
  ExpiresByType text/x-cross-domain-policy          "access plus 1 week"
  ExpiresByType application/json                    "access"
  ExpiresByType application/ld+json                 "access"
  ExpiresByType application/schema+json             "access"
  ExpiresByType application/geo+json                "access"
  ExpiresByType application/xml                     "access"
  ExpiresByType text/xml                            "access"
</IfModule>

RewriteEngine on
RewriteOptions inherit

# Remove index.html
RewriteCond %{THE_REQUEST} ^.*/index.html
RewriteRule ^(.*)index\.html$ https://%{HTTP_HOST}/$1 [R,L]

# HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R,L]

# Redirects
RewriteRule ^static/competitions/2023/kokutai-trials-1st/results\.pdf$ /static/competitions/2023/2023-04-23-kokutai-trials-1st-results.pdf [R=301,L]
RewriteRule ^static/competitions/2023/kokutai-trials-1st/start-lists\.pdf$ /static/competitions/2023/2023-04-23-kokutai-trials-1st-start-lists.pdf [R=301,L]
RewriteRule ^static/competitions/2023/kokutai-trials-2nd/results\.pdf$ /static/competitions/2023/2023-05-21-kokutai-trials-2nd-results.pdf [R=301,L]
RewriteRule ^static/competitions/2023/kokutai-trials-2nd/start-lists\.pdf$ /static/competitions/2023/2023-05-21-kokutai-trials-2nd-start-lists.pdf [R=301,L]
RewriteRule ^static/competitions/2022/kanagawa-open-championship/details\.pdf$ /static/competitions/2022/2022-11-06-kanagawa-open-championship-details.pdf [R=301,L]
RewriteRule ^static/competitions/2022/kanagawa-open-championship/start-lists\.pdf$ /static/competitions/2022/2022-11-06-kanagawa-open-championship-start-lists.pdf [R=301,L]
RewriteRule ^static/competitions/2022/kanagawa-open-championship/results\.pdf$ /static/competitions/2022/2022-11-06-kanagawa-open-championship-results.pdf [R=301,L]

