{
  "name": "@acme/yrsa.website",
  "version": "0.1.0",
  "private": true,
  "prettier": "@sasakiuri/prettier-config/tailwind",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:styles",
    "format": "repo-tooling run prettier --write .",
    "test": "repo-tooling run vitest run",
    "test:run": "repo-tooling run vitest run",
    "test:watch": "repo-tooling run vitest",
    "test:coverage": "repo-tooling run vitest run --coverage",
    "generate:feed": "repo-tooling run tsx scripts/generate-feed.ts",
    "generate:pdf": "repo-tooling run tsx scripts/generate-calendar-pdf.ts",
    "analyze": "ANALYZE=true npm run build",
    "lint:eslint": "repo-tooling run eslint . --max-warnings 0",
    "lint:prettier": "repo-tooling run prettier --check .",
    "lint:styles": "repo-tooling run stylelint \"app/**/*.css\"",
    "typecheck": "next typegen && repo-tooling run tsc --noEmit",
    "fix": "repo-tooling run eslint . --fix && repo-tooling run prettier --write ."
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/google-calendar": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.4.3",
    "pdfkit": "^0.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.3",
    "@sasakiuri/eslint-config": "file:../../../oss/packages/eslint-config",
    "@sasakiuri/prettier-config": "file:../../../oss/packages/prettier-config",
    "@sasakiuri/repo-tooling": "file:../../../oss/packages/repo-tooling",
    "@sasakiuri/stylelint-config": "file:../../../oss/packages/stylelint-config",
    "@sasakiuri/typescript-config": "file:../../../oss/packages/typescript-config",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "dotenv": "^17.2.3"
  },
  "repoTooling": {
    "upstreamPackage": "shared-tooling",
    "linkedDependencies": [
      "@tailwindcss/postcss",
      "@testing-library/jest-dom",
      "@types/react",
      "@types/react-dom",
      "@vitejs/plugin-react",
      "@vitest/coverage-v8",
      "eslint-config-next",
      "jsdom",
      "prettier-plugin-tailwindcss",
      "tsx",
      "typescript",
      "vitest"
    ],
    "installedDependencies": [
      "@testing-library/react",
      "tailwindcss",
      "@types/node"
    ]
  }
}
