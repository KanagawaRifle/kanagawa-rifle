{
  "name": "@acme/yrsa-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "prettier": "@acme/prettier-config/tailwind",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:styles",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:feed": "tsx scripts/generate-feed.ts",
    "generate:pdf": "tsx scripts/generate-calendar-pdf.ts",
    "analyze": "ANALYZE=true npm run build",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:prettier": "prettier --check .",
    "lint:styles": "stylelint \"app/**/*.css\" --max-warnings 0",
    "typecheck": "next typegen && node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "fix": "eslint . --fix && prettier --write ."
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/google-calendar": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@radix-ui/react-dialog": "^1.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "pdfkit": "^0.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@acme/eslint-config": "*",
    "@acme/prettier-config": "*",
    "@acme/stylelint-config": "*",
    "@acme/typescript-config": "*",
    "@next/bundle-analyzer": "16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "dotenv": "^17.2.3",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "5.1.1"
  }
}
