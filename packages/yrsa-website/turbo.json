{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**", "build/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "NODE_ENV",
        "NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY",
        "NEXT_PUBLIC_GOOGLE_CALENDAR_ID",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "YRSA_VALIDATION_BUILD"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env.local", ".env.production"],
      "passThroughEnv": ["VERCEL", "VERCEL_ENV", "DATABASE_URL", "SLACK_WEBHOOK_URL"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"],
      "passThroughEnv": ["VERCEL", "VERCEL_ENV", "DATABASE_URL", "SLACK_WEBHOOK_URL"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "passThroughEnv": ["VERCEL", "VERCEL_ENV", "DATABASE_URL", "SLACK_WEBHOOK_URL"]
    },
    "test": {
      "passThroughEnv": ["VERCEL", "VERCEL_ENV", "DATABASE_URL", "SLACK_WEBHOOK_URL"]
    }
  }
}
