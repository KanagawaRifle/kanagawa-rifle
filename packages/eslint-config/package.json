    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.3.0"
  },
  "peerDependencies": {
    "eslint": "^9"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.50.1"
